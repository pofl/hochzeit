---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
  class?: string;
}

const { images, class: className } = Astro.props;

// Build an optimized full-size version of each image for the lightbox.
// getImage runs through Astro's asset pipeline (Sharp), so PhotoSwipe gets a
// cache-busted, optimized URL plus the exact width/height it needs.
const slides = await Promise.all(
  images.map(async (img, i) => {
    const full = await getImage({
      src: img,
      width: Math.min(img.width, 1600),
      format: "webp",
    });
    return {
      i,
      thumb: img,
      href: full.src,
      width: full.attributes.width ?? full.options.width ?? img.width,
      height: full.attributes.height ?? Math.round((img.height / img.width) * (full.options.width ?? img.width)),
      alt: `Hochzeitsfoto ${i + 1}`,
    };
  }),
);
---

<!-- Thumbnail grid -->
<div class:list={["gallery", className]} data-photo-gallery>
  {
    slides.map((slide) => (
      <a
        href={slide.href}
        class="item lightbox-trigger"
        data-pswp-width={slide.width}
        data-pswp-height={slide.height}
        target="_blank"
        rel="noreferrer"
        aria-label={`Foto ${slide.i + 1} öffnen`}
      >
        <Image
          src={slide.thumb}
          alt={slide.alt}
          widths={[400, 800]}
          sizes="600px"
        />
      </a>
    ))
  }
</div>

<script>
  import PhotoSwipe from "photoswipe";
import PhotoSwipeLightbox from "photoswipe/lightbox";
import "photoswipe/style.css";

  let lightboxes: PhotoSwipeLightbox[] = [];

  function initPhotoSwipe() {
    lightboxes.forEach((lightbox) => lightbox.destroy());
    lightboxes = [];

    document.querySelectorAll<HTMLElement>("[data-photo-gallery]").forEach((gallery) => {
      if (!gallery.querySelector(".lightbox-trigger")) return;
      const lightbox = new PhotoSwipeLightbox({
        gallery,
        children: ".lightbox-trigger",
        pswpModule: PhotoSwipe,
      });
      lightbox.init();
      lightboxes.push(lightbox);
    });
  }

  initPhotoSwipe();
  document.addEventListener("astro:page-load", initPhotoSwipe);
</script>

<style>
  /* ── Thumbnail grid ─────────────────────────────────────────────────────── */
  .gallery {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }

  .item {
    flex: 0 0 auto;
    scroll-snap-align: start;
    display: block;
    overflow: hidden;
    cursor: zoom-in;
  }

  .item img {
    display: block;
    width: 20rem;
    height: 20rem;
    max-width: none;
    object-fit: cover;
    transition: opacity 0.2s;
  }

  .item:hover img {
    opacity: 0.85;
  }
</style>
