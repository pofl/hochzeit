---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  backgroundImage?: ImageMetadata;
}

const { backgroundImage } = Astro.props;
---

<header class:list={["header", { "has-image": backgroundImage }]}>
  {
    backgroundImage && (
      <Image
        src={backgroundImage}
        alt=""
        widths={[800, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        class="header-image"
      />
    )
  }
  <h1 class="title">Shruti und Flo heiraten</h1>
  <div class="info">
    <span>In Bengaluru 🇮🇳</span>
    <span>5. bis 8. Mai 2026</span>
  </div>
</header>

<style>
  .header {
    margin-top: 100px;
    margin-bottom: 100px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  /* Full-bleed hero: cancels the body's 1rem side padding and its 40px margin plus 1rem top padding */
  .header.has-image {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin: calc(-40px - 1rem) -1rem 100px;
    padding: 160px 1rem 100px;
    color: white;
    text-shadow:
      0 0 2px #000,
      0 0 4px #000,
      0 0 8px #000,
      0 2px 24px #000,
      0 0 48px rgb(0 0 0 / 0.8);
  }

  .header-image {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .title {
    margin: 0;
    font-size: 4em;
    font-family: var(--font-tangerine), serif;
    font-optical-sizing: auto;
    font-weight: 400;
    font-style: normal;
  }

  .info {
    display: flex;
    justify-content: space-around;
    align-items: center;
    gap: 0 1.5em;
    flex-wrap: wrap;
    margin: 40px 0 0;

    border-top: 1px solid;
    border-bottom: 1px solid;
    padding: 8px 1em;

    font-size: 1.5em;
    font-family: var(--font-playfair-display), serif;
    font-optical-sizing: auto;
    font-weight: 400;
    font-style: normal;
  }

  /* text-shadow doesn't reach borders, so drop-shadow outlines the whole box, borders included */
  .header.has-image .info {
    text-shadow: none;
    filter: drop-shadow(0 0 2px #000) drop-shadow(0 0 4px #000) drop-shadow(0 2px 12px #000);
  }
</style>
